# ==============================================================================
# MINDORA 2.0 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure variables for your target environment.
# NEVER commit actual secrets, private keys, or production credentials to Git.
# ==============================================================================

# Application Environment Mode: development | production | testing
# In 'production' mode:
#   - Development fallback tokens ("local_dev_session") are strictly rejected.
#   - API docs (/docs, /redoc) are disabled unless explicitly re-enabled.
#   - MINDORA_SECRET_KEY must be provided and meet entropy standards.
#   - Wildcard CORS origins are forbidden.
MINDORA_ENV=development

# Server Network Binding
MINDORA_HOST=127.0.0.1
MINDORA_PORT=8000

# Cryptographic Secret Key for Session Signing & Token Entropy
# Production requirement: Minimum 32-byte (64 hex characters) cryptographically random string.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
MINDORA_SECRET_KEY=dev_insecure_secret_key_replace_in_production_32bytes_minimum_length_required

# Permitted CORS Origins (comma-separated list, NO wildcards allowed in production)
# Example: https://mindora.vercel.app,https://student.university.edu
MINDORA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# SQLite Database Location
# In cloud deployments (e.g. Render), this MUST point to a mounted persistent disk volume.
# Ephemeral container filesystems will cause total data loss on restart!
MINDORA_DB_PATH=data/mindora_auth.db

# API Documentation Visibility (/docs and /redoc)
# Recommended: false in production, true in development
MINDORA_DOCS_ENABLED=true

# Optional Local AI Companion Runtime (Ollama / Qwen)
MINDORA_OLLAMA_BASE_URL=http://127.0.0.1:11434
MINDORA_OLLAMA_MODEL=qwen3:4b

# SMS Provider Configuration for Guardian Support Notifications (Legacy)
# Options: 'mock' (default, safe for local testing/CI) | 'fast2sms' (real Indian SMS gateway)
SMS_PROVIDER=mock
# SMS_API_KEY=your_fast2sms_api_key_here
# SMS_SENDER_ID=MINDOR
# SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2

# ==============================================================================
# PHASE 6.1 — SMTP EMAIL CONFIGURATION FOR GUARDIAN ALERTS & VERIFICATION
# ==============================================================================
# Production SMTP provider configuration (e.g. Gmail App Password, SendGrid, Amazon SES, Mailgun)
# Never commit actual credentials to Git!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=notifications@mindora-wellness.org
SMTP_PASSWORD=your_secure_smtp_app_password
EMAIL_FROM="Mindora Student Wellbeing Platform <notifications@mindora-wellness.org>"
SMTP_USE_SSL=true
SMTP_TIMEOUT=15
